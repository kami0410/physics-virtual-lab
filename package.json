  },
  "homepage": "https://kami0410.github.io/physics-virtual-lab/",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview",
    "relay": "node tools/ai-relay.mjs",
    "relay:install": "node tools/ai-relay.mjs --install",
    "relay:uninstall": "node tools/ai-relay.mjs --uninstall",
    "test": "node tests/physics.mjs && node tests/physics-tools.mjs && npm run build:single && node tests/tutor-ai.mjs && node tests/e2e.mjs",
    "test:physics": "node tests/physics.mjs && node tests/physics-tools.mjs",
    "test:quick": "node tests/e2e.mjs --monkey 150"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.14.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@spice-ts/core": "0.4.0",
    "katex": "^0.19.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "playwright-core": "^1.49.1",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4"
  }
